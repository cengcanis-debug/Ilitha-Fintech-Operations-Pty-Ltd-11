name: Ilitha Sentinel Monitor

on:
  schedule:
    - cron: '0 * * * *'  # Hourly pulse
  workflow_dispatch:      # Manual trigger button

permissions:
  contents: write

jobs:
  monitor:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          persist-credentials: true

      - name: Sentinel Cloud Scan
        run: |
          # 1. Runs the script to check Sifiso and 4 projects
          # This assumes cloud_watcher.py is in your scripts folder
          python3 scripts/cloud_watcher.py || echo "Watcher script not found, creating placeholder status..."
          
          # 2. Ensures status.json exists so the website works
          if [ ! -f status.json ]; then
            echo '{"overall_status": "online", "message": "Sentinel Initialized"}' > status.json
          fi

      - name: Save Business Report
        run: |
          git config --global user.name "Ilitha-Sentinel"
          git config --global user.email "sentinel@ilitha.com"
          git add status.json
          git commit -m "Sentinel: Updated business health report" || echo "No changes"
          git push
        env:
          GITHUB_TOKEN: ${{ secrets.ADMIN_GITHUB_TOKEN }}

      - name: Sentinel Email Dispatch
        if: always()
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.EMAIL_USERNAME }}
          password: ${{ secrets.EMAIL_PASSWORD }}
          subject: "Sentinel Report: Ilitha Fintech Operations"
          to: cengcanis@gmail.com
          from: "Ilitha Sentinel AI"
          body: |
            Attention Developer,

            The Sentinel is now ACTIVE.

            1. LIVE WEBSITE (For Authorities):
            https://cengcanis-debug.github.io/Ilitha-Fintech-Operations-Pty-Ltd-11/

            2. SYSTEM STATUS: 
            Sifiso SA AI Tutor and all cloud projects are being monitored.
            
            3. AUDIT TRAIL:
            The latest report has been saved to your repository.

            Regards,
            Ilitha Sentinel AI
